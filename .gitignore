# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions and build artifacts
*.so
*.dylib
*.dll
*.o
*.a
build/
dist/
*.egg-info/
.eggs/

# Cython intermediate files (generated)
# Note: Hand-written C sources under caesura/native/ are tracked
caesura/**/*.c
!caesura/native/*.c
!caesura/native/*.h

# Virtual environments
.venv/
env/
venv/
ENV/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# IDE and OS files
.DS_Store
.idea/
.vscode/
*.swp
*.swo
